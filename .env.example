# Copy to .env and fill in real values. Never commit the real .env.
# Configuration and non-secret policies live in config/agent-providers.yaml
# (runtime JSON twin: config/agent-providers.json).

# --- Server & Frontend ------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production / hosted .tech:
# NEXT_PUBLIC_SITE_URL=https://truelockfa.tech
# NEXT_PUBLIC_API_URL=https://api.truelockfa.tech
# FRONTEND_ORIGIN=https://truelockfa.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------
# Host port 5433 matches docker-compose.yml (maps 5433:5432; avoids local
# Windows Postgres on 5432). Judges: use 5433 on the host, never commit .env.
DATABASE_URL=postgresql://truelock:truelock_dev_only@localhost:5433/truelock
POSTGRES_PASSWORD=truelock_dev_only

# --- Google Gemini API (authorized multi-project pool) ----------------
# Prefer GEMINI_KEY_A..D from config/agent-providers.yaml.
# GEMINI_API_KEY remains a fallback for project A / local demos.
# Leave blank for deterministic fallback-only demos. Never commit real keys.
GEMINI_API_KEY=
GEMINI_KEY_A=
GEMINI_KEY_B=
GEMINI_KEY_C=
GEMINI_KEY_D=
GEMINI_MODEL=gemini-2.5-flash
TRUELOCK_PROVIDERS_CONFIG=config/agent-providers.json

# --- Forensic Investigation Constraints --------------------------------
MAX_INVESTIGATION_STEPS=10
MAX_INVESTIGATION_SECONDS=30
MAX_SESSION_BUDGET_USD=75
HARD_BUDGET_STOP_USD=280
DEMO_MODE=false
