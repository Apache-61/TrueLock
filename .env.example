# Copy to .env and fill in real values. Never commit the real .env.
# See orchestrator/policies/provider-pool.yaml for how multiple Gemini
# projects/keys are pooled and routed across the 4 workstations.

# --- Identity ---------------------------------------------------------
WORKER_ID=                     # e.g. WORKER-01 .. WORKER-04, set per machine

# --- Gemini (forensic + development use — see ARCHITECTURE.md §6) -----
GEMINI_KEY_A=
GEMINI_KEY_B=
GEMINI_KEY_C=
GEMINI_KEY_D=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_SYNTHESIS_MODEL=gemini-2.5-pro

# --- GitHub (task queue / claim protocol source of truth) --------------
GITHUB_TOKEN=                  # repo-scoped PAT or app token, least privilege
GITHUB_OWNER=apache-61
GITHUB_REPO=truelock

# --- AI development worker (orchestrator/workers/) ---------------------
# See docs/orchestration/worker-setup.md. Only WORKER_ID above and the
# three GITHUB_* keys are required; everything here has a working default.
WORKER_BASE_BRANCH=main        # branch the worker opens PRs against
WORKER_ADAPTER=claude_code     # claude_code | mock (mock calls no API)
WORKER_MODEL=                  # passed to the adapter's --model, if set
WORKER_AI_TIMEOUT=3600         # seconds before a single task is abandoned
CLAUDE_CLI_BIN=claude          # the Claude Code binary to invoke
CLAUDE_CLI_EXTRA_ARGS=         # extra CLI arguments, shell-split
WORKER_LABELS_AVAILABLE=1      # labels now exist; leave at 1

# --- Continuous mode (worker start --continuous) -----------------------
# See ADR-0006. These only affect a continuous run; --once ignores them.
WORKER_POLL_SECONDS=120         # wait before re-reading the queue when idle
WORKER_CLAIM_STALE_MINUTES=180  # take over a claim after this much silence
                                # on its issue. Must stay well above
                                # WORKER_AI_TIMEOUT or two machines will
                                # work the same task.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://truelock:truelock@localhost:5432/truelock
# Fallback if Postgres is unavailable during a live demo:
SQLITE_FALLBACK_PATH=./data/fixtures/truelock.db

# --- Optional sponsor integrations (see research/rejected-ideas/) -------
SOLANA_RPC_URL=
SOLANA_NOTARY_KEYPAIR_PATH=
ELEVENLABS_API_KEY=

# --- Observability --------------------------------------------------------
EVENT_LOG_PATH=./.state/events.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Budget guardrails (orchestrator/policies/, see docs there) --------
MAX_SESSION_BUDGET_USD=75
HARD_BUDGET_STOP_USD=280
