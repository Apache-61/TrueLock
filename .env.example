# Copy to .env and fill in real values. Never commit the real .env.
# Configuration and non-secret policies live in config/agent-providers.yaml.

# --- Server & Frontend ------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Database ---------------------------------------------------------
DATABASE_URL=postgresql://truelock:truelock_dev_only@localhost:5432/truelock
