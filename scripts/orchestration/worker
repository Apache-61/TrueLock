#!/usr/bin/env bash
# `worker` — shim so the documented command works verbatim once
# scripts/orchestration/ is on PATH:
#
#     export PATH="$PWD/scripts/orchestration:$PATH"
#     worker start --once
#
# Resolves its own location, so it works from any working directory and
# through a symlink.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink "$source_path")"
  [[ $source_path != /* ]] && source_path="$dir/$source_path"
done
script_dir="$(cd -P "$(dirname "$source_path")" && pwd)"

exec "${PYTHON:-python3}" "$script_dir/worker.py" "$@"
